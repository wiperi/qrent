# QRent Scraper Docker Image with VNC
# 支持通过浏览器查看容器内的桌面，用于手动完成验证
FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV DISPLAY=:99

# 安装 Xvfb + x11vnc + noVNC
USER root
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 复制源代码
COPY src/ ./src/
COPY main.py .
COPY run_scraper.py .
COPY entrypoint-vnc.sh .

# 创建必要目录
RUN mkdir -p /app/logs /app/output /app/domain_profile /app/rea_profile

# 设置权限
RUN chmod +x /app/entrypoint-vnc.sh && \
    chown -R pwuser:pwuser /app

USER pwuser

EXPOSE 6080

ENTRYPOINT ["/app/entrypoint-vnc.sh"]
CMD ["python", "run_scraper.py", "--scrapers", "realestate", "--universities", "UNSW", "--no-database", "--no-scoring", "--no-commute"]

